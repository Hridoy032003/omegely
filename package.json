{
  "name": "omegley",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "Anonymous random 1:1 video, voice & text chat (Omegle-style) — serverless on Vercel with WebRTC + Ably.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm build",
    "start": "next start",
    "dev:admin": "pnpm --dir apps/admin dev",
    "dev:pwa": "pnpm --dir apps/pwa dev"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "ably": "^2.28.0",
    "next": "^16.3.6",
    "posthog-js": "^1.430.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ],
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20.14.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.3"
  }
}

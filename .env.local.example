# Ably realtime API key — required. Get a free one at https://ably.com/
# (Dashboard -> App -> API Keys). The default "Root" key works. Copy this file
# to `.env.local` for local dev, and set the same variables in
# Vercel -> Project -> Settings -> Environment Variables.
ABLY_API_KEY=your-app.your-key:your-secret

# PostHog analytics — optional. Leave blank to disable analytics entirely.
# Get the key from PostHog -> Project Settings -> Project API Key.
# Host: https://us.i.posthog.com (US) or https://eu.i.posthog.com (EU).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional accounts and profiles. Chat remains usable without an account.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key
